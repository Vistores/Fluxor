<Window x:Class="CursorFX.App.ArchiveImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, RelativeSource={RelativeSource AncestorType=Window}}"
        Icon="pack://application:,,,/Assets/FluxorIco.ico"
        Width="620"
        Height="560"
        MinWidth="560"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Padding="0,12,0,0"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding CancelText, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnCancelClick" />
                <Button Content="{Binding ImportCopyText, RelativeSource={RelativeSource AncestorType=Window}}"
                        Click="OnImportCopyClick" />
                <Button Content="{Binding ReplaceText, RelativeSource={RelativeSource AncestorType=Window}}"
                        Click="OnReplaceClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanReplace}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="{Binding HeadingText, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Margin="0,10,0,18"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding IntroText, RelativeSource={RelativeSource AncestorType=Window}}" />

                <Border Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding NameLabelText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Grid.Column="1" Text="{Binding ProfileName}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding IdLabelText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Grid.Column="1" Text="{Binding ProfileId}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding RuntimeLabelText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Grid.Column="1" Text="{Binding RuntimeLabel}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding ParametersLabelText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Grid.Column="1" Text="{Binding ParameterCount}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding IconLabelText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Grid.Column="1" Text="{Binding HasIconText}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding AssemblyLabelText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Grid.Column="1" Text="{Binding HasAssemblyText}" />
                        </Grid>

                        <TextBlock Margin="0,12,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding Description}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding ConflictTitleText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource AccentMutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding ConflictSummary}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding WarningsTitleText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,6"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
