<Window x:Class="CursorFX.App.PluginAuthoringGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fluxor · Plugin Authoring Guide"
        Icon="pack://application:,,,/Assets/FluxorIco.ico"
        Width="840"
        Height="720"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Padding="0,12,0,0"
                BorderBrush="#24415D"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy Guide" Click="OnCopyClick" />
                <Button Content="Close" Click="OnCloseClick" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Plugin Authoring Guide" />
                <TextBlock Margin="0,10,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="How to structure C# + JSON plugin files, link them correctly, and avoid runtime or import failures." />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,18,0,0"
                    Padding="14"
                    Background="#0D1726"
                    BorderBrush="#24415D"
                    BorderThickness="1"
                    CornerRadius="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="GuideTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled" />
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
