<Window x:Class="CursorFX.App.NewPluginProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Plugin Profile"
        Width="520"
        Height="420"
        MinWidth="460"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancelClick" />
            <Button Content="Create Profile" Click="OnCreateClick" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Create Plugin Profile" />
                <TextBlock Margin="0,10,0,18"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           Text="This creates a full profile JSON based on the current plugin, including Trail, Glow, Ripple and Shader categories with their current values." />

                <TextBlock Text="Profile Name" />
                <TextBox Text="{Binding PluginName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Profile Id" />
                <TextBox Text="{Binding PluginId, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Description" />
                <TextBox Height="110"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding PluginDescription, UpdateSourceTrigger=PropertyChanged}" />

                <Border Margin="0,8,0,0"
                        Padding="12"
                        Background="#0B1220"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="12">
                    <TextBlock Foreground="#94A3B8" TextWrapping="Wrap" Text="{Binding HintText}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
