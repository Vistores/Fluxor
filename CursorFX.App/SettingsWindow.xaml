<Window x:Class="CursorFX.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, RelativeSource={RelativeSource AncestorType=Window}}"
        Icon="pack://application:,,,/Assets/FluxorIco.ico"
        Width="520"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="20"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding HeadingText, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Margin="0,8,0,20"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding IntroText, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding StartupTitle, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <CheckBox Margin="0,14,0,0"
                                      IsChecked="{Binding LaunchOnStartup, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Content="{Binding LaunchOnStartupText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding BackgroundModeTitle, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <CheckBox Margin="0,14,0,0"
                                      IsChecked="{Binding RunInBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Content="{Binding RunInBackgroundText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding RenderGuardTitle, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <CheckBox Margin="0,14,0,0"
                                      IsChecked="{Binding PauseWhenCursorHidden, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Content="{Binding PauseWhenCursorHiddenText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding LanguageTitle, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <CheckBox Margin="0,14,0,0"
                                      IsChecked="{Binding UseSystemLanguage, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Content="{Binding UseSystemLanguageText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Margin="0,14,0,8"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding LanguageLabelText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ComboBox ItemsSource="{Binding AvailableLanguages, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding SelectedLanguageCode, RelativeSource={RelativeSource AncestorType=Window}}"
                                      IsEnabled="{Binding IsLanguageSelectionEnabled, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding LanguageHintText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding PluginToolsTitle, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding PluginToolsHintText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="{Binding OpenGuideButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnOpenGuideClick" />
                                <Button Content="{Binding OpenPluginsFolderButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnOpenPluginsFolderClick" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button MinWidth="96" Content="{Binding CancelButtonText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
            <Button MinWidth="96" Content="{Binding ApplyButtonText, RelativeSource={RelativeSource AncestorType=Window}}" IsDefault="True" Click="OnApplyClick" />
        </StackPanel>
    </Grid>
</Window>
