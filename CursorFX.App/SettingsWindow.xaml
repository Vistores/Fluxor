<Window x:Class="CursorFX.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fluxor · Settings"
        Icon="pack://application:,,,/Assets/FluxorIco.ico"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="20"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="Fluxor Settings" />
                    <TextBlock Margin="0,8,0,20"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="Control how Fluxor starts, behaves in the background and when it should automatically suspend effects." />

                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Startup" />
                            <CheckBox Margin="0,14,0,0"
                                      IsChecked="{Binding LaunchOnStartup, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Content="Launch Fluxor when Windows starts" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Background Mode" />
                            <CheckBox Margin="0,14,0,0"
                                      IsChecked="{Binding RunInBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Content="Keep Fluxor running in the tray when the main window is closed or minimized" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Render Guard" />
                            <CheckBox Margin="0,14,0,0"
                                      IsChecked="{Binding PauseWhenCursorHidden, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Content="Pause effects when a fullscreen app hides the cursor" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button MinWidth="96" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
            <Button MinWidth="96" Content="Apply" IsDefault="True" Click="OnApplyClick" />
        </StackPanel>
    </Grid>
</Window>
