    { "Key": "jitter", "DisplayName": "Bolt Jitter", "Section": 3, "SectionName": "Lightning Field", "Type": 0, "Min": 0.5, "Max": 24, "Step": 0.5, "DefaultNumber": 9, "DefaultColor": "#FFFFFF" },
    { "Key": "impactRadius", "DisplayName": "Impact Radius", "Section": 3, "SectionName": "Impact Field", "Type": 0, "Min": 8, "Max": 180, "Step": 1, "DefaultNumber": 84, "DefaultColor": "#FFFFFF" },
    { "Key": "boltLifetime", "DisplayName": "Impact Lifetime", "Section": 3, "SectionName": "Impact Field", "Type": 0, "Min": 0.05, "Max": 1.5, "Step": 0.01, "DefaultNumber": 0.32, "DefaultColor": "#FFFFFF" }
  ]
