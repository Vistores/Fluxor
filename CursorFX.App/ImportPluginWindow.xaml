<Window x:Class="CursorFX.App.ImportPluginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fluxor | Import Plugin"
        Icon="pack://application:,,,/Assets/FluxorIco.ico"
        Width="700"
        Height="620"
        MinWidth="560"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Padding="0,12,0,0"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelClick" />
                <Button Content="Import Plugin" Click="OnImportClick" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Import Plugin" />
                <TextBlock Margin="0,10,0,18"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="Choose a plugin DLL. Fluxor will read plugin metadata and parameter schema directly from the assembly, generate the profile automatically and copy companion runtime files when they exist." />

                <Border Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="DLL Assembly File" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="The DLL must contain a public ICursorEffectPlugin implementation and expose settings via GetParameters()." />
                        <TextBox Margin="0,8,0,0" IsReadOnly="True" Text="{Binding AssemblyPath, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Browse DLL File" Style="{StaticResource SecondaryButtonStyle}" Click="OnBrowseAssemblyClick" />
                            <Button Content="Open Plugins Folder" Style="{StaticResource GhostButtonStyle}" Click="OnOpenWorkspaceClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Plugin Type" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="If the DLL contains multiple plugins, choose which one should be imported." />
                        <ComboBox Margin="0,8,0,0"
                                  ItemsSource="{Binding AvailablePlugins}"
                                  SelectedItem="{Binding SelectedPluginCandidate, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayName" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource AccentMutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding SelectedPluginSummary}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Import Preview" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Fluxor will generate the plugin profile directly from the selected assembly metadata." />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="Display name" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPluginDisplayName}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="Plugin ID" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPluginId}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="Entry type" />
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding SelectedPluginEntryType}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="68"
                                Height="68"
                                VerticalAlignment="Top"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding IconPath}" Stretch="UniformToFill" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Icon">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IconPath}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock FontWeight="SemiBold" Text="Plugin Icon" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="Optional image for the plugin card. Fluxor will copy it to the plugin catalog and render it as a square icon." />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource AccentMutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding IconFileName}" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Choose Icon" Style="{StaticResource SecondaryButtonStyle}" Click="OnBrowseIconClick" />
                                <Button Content="Clear Icon" Style="{StaticResource GhostButtonStyle}" Click="OnClearIconClick" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
