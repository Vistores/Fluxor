<Window x:Class="CursorFX.App.ImportPluginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, RelativeSource={RelativeSource AncestorType=Window}}"
        Icon="pack://application:,,,/Assets/FluxorIco.ico"
        Width="700"
        Height="620"
        MinWidth="560"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Padding="0,12,0,0"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding CancelButtonText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelClick" />
                <Button Content="{Binding ImportButtonText, RelativeSource={RelativeSource AncestorType=Window}}" Click="OnImportClick" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding HeadingText, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Margin="0,10,0,18"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding IntroText, RelativeSource={RelativeSource AncestorType=Window}}" />

                <Border Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding AssemblyTitleText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding AssemblyHintText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBox Margin="0,8,0,0" IsReadOnly="True" Text="{Binding AssemblyPath, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{Binding BrowseDllButtonText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButtonStyle}" Click="OnBrowseAssemblyClick" />
                            <Button Content="{Binding OpenWorkspaceButtonText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButtonStyle}" Click="OnOpenWorkspaceClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding PluginTypeTitleText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding PluginTypeHintText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ComboBox Margin="0,8,0,0"
                                  ItemsSource="{Binding AvailablePlugins}"
                                  SelectedItem="{Binding SelectedPluginCandidate, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayName" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource AccentMutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding SelectedPluginSummary}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding PreviewTitleText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding PreviewHintText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding PreviewDisplayNameText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPluginDisplayName}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding PreviewPluginIdText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPluginId}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding PreviewEntryTypeText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding SelectedPluginEntryType}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="68"
                                Height="68"
                                VerticalAlignment="Top"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding IconPath}" Stretch="UniformToFill" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding IconPlaceholderText, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IconPath}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding IconTitleText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding IconHintText, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource AccentMutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding IconFileName}" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="{Binding ChooseIconButtonText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButtonStyle}" Click="OnBrowseIconClick" />
                                <Button Content="{Binding ClearIconButtonText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButtonStyle}" Click="OnClearIconClick" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
