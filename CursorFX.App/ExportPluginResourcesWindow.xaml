<Window x:Class="CursorFX.App.ExportPluginResourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fluxor · Export Plugin Resources"
        Icon="pack://application:,,,/Assets/FluxorIco.ico"
        Width="620"
        Height="420"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Padding="0,12,0,0"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelClick" />
                <Button Content="Export" Click="OnExportClick" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Export Plugin Resources" />
                <TextBlock Margin="0,10,0,18"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="Choose which resources to export for the selected plugin. JSON manifest is always available. C# source is available only if Fluxor can find the original source file." />

                <Border Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="16">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding ExportJson}" Content="Export JSON Manifest" />
                        <TextBox Margin="0,8,0,0" Text="{Binding JsonPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Browse JSON Path" Style="{StaticResource SecondaryButtonStyle}" Click="OnBrowseJsonClick" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="16" Opacity="{Binding SourceSectionOpacity}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding ExportSource}" IsEnabled="{Binding HasSourceFile}" Content="Export C# Source File" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding SourceStatusText}" />
                        <TextBox Margin="0,8,0,0" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSourceFile}" />
                        <Button Content="Browse C# Path" Style="{StaticResource SecondaryButtonStyle}" Click="OnBrowseSourceClick" HorizontalAlignment="Left" IsEnabled="{Binding HasSourceFile}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
