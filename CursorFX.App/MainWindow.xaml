<Window x:Class="CursorFX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CursorFX.App.ViewModels"
        mc:Ignorable="d"
        Title="Fluxor"
        Icon="pack://application:,,,/Assets/FluxorIco.ico"
        Width="1240"
        Height="820"
        MinWidth="1040"
        MinHeight="700"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ShaderTemplateParameterViewModel}">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    Background="{StaticResource SurfaceInsetBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,2">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding DisplayName}" />
                    </DockPanel>

                    <StackPanel Margin="0,8,0,0" Visibility="{Binding NumberVisibility}">
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Text="{Binding Minimum, StringFormat=Min {0:F0}}" />
                            <TextBlock DockPanel.Dock="Right"
                                       Foreground="{StaticResource AccentStrongBrush}"
                                       FontSize="12"
                                       Text="{Binding NumberValue, StringFormat={}{0:F2}}" />
                        </DockPanel>
                        <Slider Minimum="{Binding Minimum}"
                                Maximum="{Binding Maximum}"
                                Value="{Binding NumberValue}"
                                TickFrequency="{Binding Step}" />
                    </StackPanel>

                    <DockPanel Margin="0,8,0,0" LastChildFill="False" Visibility="{Binding ColorVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18"
                                    Height="18"
                                    CornerRadius="4"
                                    Background="{Binding ColorValue}"
                                    BorderBrush="{StaticResource AccentStrongBrush}"
                                    BorderThickness="1" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding ColorValue}" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Choose"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding PickColorCommand}" />
                    </DockPanel>

                    <CheckBox Margin="0,8,0,0"
                              Visibility="{Binding ToggleVisibility}"
                              IsChecked="{Binding BooleanValue}"
                              Content="Enabled" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PluginCategoryViewModel}">
            <Expander IsExpanded="True"
                      Style="{StaticResource CompactExpanderStyle}"
                      Header="{Binding Name}">
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Parameters}" />
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="PluginListItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="38"
                        Height="38"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{Binding AccentColor}"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding ResolvedIconPath}" Stretch="UniformToFill" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#07131F"
                                   Text="{Binding IconGlyph}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResolvedIconPath}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ResolvedIconPath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1">
                    <DockPanel LastChildFill="False">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" />
                        <Border Margin="10,0,0,0"
                                Padding="7,2"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentStrongBrush}"
                                       Text="{Binding RuntimeKind}" />
                        </Border>
                    </DockPanel>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               MaxHeight="34"
                               TextWrapping="Wrap"
                               Text="{Binding Description}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.95*" />
            <ColumnDefinition Width="0.95*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="0,0,18,0"
                Padding="18"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="18"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="30" Height="30" Margin="0,0,10,0" Source="pack://application:,,,/Assets/FluxorIco.ico" />
                                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Fluxor" />
                            </StackPanel>
                            <TextBlock Margin="40,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"
                                       Text="Choose a style, tune it live, and keep cursor effects stable without visual overload." />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                            <Button Content="Application Settings" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenSettingsCommand}" />
                            <Button Content="Import Plugin" Command="{Binding ImportTemplateCommand}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="MainScrollViewer"
                              Grid.Row="1"
                              Margin="0,16,0,0"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="OnNestedScrollViewerMouseWheel">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="General" />
                                    <TextBlock Margin="0,10,0,0" FontSize="13" Text="{Binding EffectOpacityLabel}" />
                                    <Slider Minimum="0.1" Maximum="1.0" Value="{Binding MasterOpacity}" TickFrequency="0.02" />
                                    <TextBlock FontSize="13" Text="{Binding FpsLabel}" />
                                    <Slider Minimum="30" Maximum="144" Value="{Binding TargetFps}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Current Profile" />
                                    <DockPanel Margin="0,10,0,0" LastChildFill="True">
                                        <Border Width="52"
                                                Height="52"
                                                Margin="0,0,12,0"
                                                Background="{StaticResource SurfaceRaisedBrush}"
                                                BorderBrush="{StaticResource SurfaceBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding SelectedPluginResolvedIconPath}" Stretch="UniformToFill" />
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="Icon">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedPluginResolvedIconPath}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedPluginResolvedIconPath}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SelectedPluginName}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="34"
                                                       Text="{Binding SelectedPluginDescription}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Choose Icon" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ChoosePluginIconCommand}" />
                                        <Button Content="Clear Icon" Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearPluginIconCommand}" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Save" Command="{Binding SaveSettingsCommand}" />
                                        <Button Content="Reset" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetPluginSettingsCommand}" />
                                        <Button Content="Folder" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenPluginFolderCommand}" />
                                        <Button Content="Delete"
                                                Command="{Binding DeletePluginCommand}"
                                                Style="{StaticResource DangerButtonStyle}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource PanelCardStyle}">
                            <DockPanel LastChildFill="False">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Plugin Authoring" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Text="Open the built-in guide to see how to structure plugin JSON and C# files correctly." />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        Content="Open Authoring Guide"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenPluginAuthoringGuideCommand}" />
                            </DockPanel>
                        </Border>

                        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding PluginCategories}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Padding="18"
                Background="{StaticResource CardBackgroundSecondaryBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                PreviewMouseWheel="OnProfilesPaneMouseWheel">
            <ScrollViewer x:Name="ProfilesScrollViewer"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="21" FontWeight="SemiBold" Text="Profiles" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   Text="10 built-in starter profiles are available, plus any custom DLL plugins you import." />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             Margin="0,14,0,14"
                             ItemsSource="{Binding AvailablePlugins}"
                             SelectedItem="{Binding SelectedPlugin}"
                             PreviewMouseWheel="OnProfilesPaneMouseWheel"
                             ItemTemplate="{StaticResource PluginListItemTemplate}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                    <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Status" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Text="{Binding AutosaveStatus}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
