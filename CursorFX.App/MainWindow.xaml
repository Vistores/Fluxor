<Window x:Class="CursorFX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CursorFX.App.ViewModels"
        mc:Ignorable="d"
        Title="Fluxor"
        Icon="pack://application:,,,/Assets/FluxorIco.ico"
        Width="1260"
        Height="840"
        MinWidth="1080"
        MinHeight="720"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ShaderTemplateParameterViewModel}">
            <Border Margin="0,0,0,10"
                    Padding="12"
                    Background="{StaticResource SurfaceInsetBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding DisplayName}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Foreground="{StaticResource AccentMutedBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding NumberValue, StringFormat={}{0:F2}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNumber}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>

                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Visibility="{Binding HelperVisibility}"
                               Text="{Binding HelperText}" />

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding NumberVisibility}">
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}"
                                       FontSize="11"
                                       Text="{Binding Minimum, StringFormat=Min {0:F0}}" />
                            <TextBlock DockPanel.Dock="Right"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       FontSize="11"
                                       Text="{Binding Maximum, StringFormat=Max {0:F0}}" />
                        </DockPanel>
                        <Slider Minimum="{Binding Minimum}"
                                Maximum="{Binding Maximum}"
                                Value="{Binding NumberValue}"
                                TickFrequency="{Binding Step}" />
                    </StackPanel>

                    <DockPanel Margin="0,10,0,0" LastChildFill="False" Visibility="{Binding ColorVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18"
                                    Height="18"
                                    CornerRadius="4"
                                    Background="{Binding ColorValue}"
                                    BorderBrush="{StaticResource AccentStrongBrush}"
                                    BorderThickness="1" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding ColorValue}" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Choose"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding PickColorCommand}" />
                    </DockPanel>

                    <CheckBox Margin="0,10,0,0"
                              Visibility="{Binding ToggleVisibility}"
                              IsChecked="{Binding BooleanValue}"
                              Content="Enabled" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PluginCategoryViewModel}">
            <Expander IsExpanded="True"
                      Style="{StaticResource CompactExpanderStyle}"
                      Header="{Binding Name}">
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Parameters}" />
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="PluginListItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="40"
                        Height="40"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{Binding AccentColor}"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding ResolvedIconPath}" Stretch="UniformToFill" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#07131F"
                                   Text="{Binding IconGlyph}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResolvedIconPath}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ResolvedIconPath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1">
                    <DockPanel LastChildFill="False">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="{Binding Name}" />
                        <Border Margin="10,0,0,0"
                                Padding="7,2"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentStrongBrush}"
                                       Text="{Binding RuntimeKind}" />
                        </Border>
                    </DockPanel>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               MaxHeight="34"
                               TextWrapping="Wrap"
                               Text="{Binding Description}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.05*" />
            <ColumnDefinition Width="0.95*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="0,0,18,0"
                Padding="18"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="18"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="30"
                                       Height="30"
                                       Margin="0,0,10,0"
                                       Source="pack://application:,,,/Assets/FluxorIco.ico" />
                                <TextBlock FontSize="28"
                                           FontWeight="SemiBold"
                                           Text="Fluxor" />
                            </StackPanel>
                            <TextBlock Margin="40,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"
                                       Text="{Binding HeroSubtitle}" />
                            <TextBlock Margin="40,6,0,0"
                                       Foreground="{StaticResource AccentStrongBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="{Binding ApplicationSignature}" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1"
                                   VerticalAlignment="Top">
                            <Button Content="{Binding ApplicationSettingsText}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenSettingsCommand}" />
                            <Button Content="{Binding ImportPluginText}"
                                    Command="{Binding ImportTemplateCommand}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="MainScrollViewer"
                              Grid.Row="1"
                              Margin="0,16,0,0"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="OnNestedScrollViewerMouseWheel">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,14,0">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="64"
                                                Height="64"
                                                Margin="0,0,14,0"
                                                Background="{StaticResource SurfaceRaisedBrush}"
                                                BorderBrush="{StaticResource SurfaceBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding SelectedPluginResolvedIconPath}" Stretch="UniformToFill" />
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding IconPlaceholderText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedPluginResolvedIconPath}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedPluginResolvedIconPath}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <StackPanel>
                                            <TextBlock FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentMutedBrush}"
                                                       Text="{Binding CurrentProfileText}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SelectedPluginName}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12.5"
                                                       MaxWidth="520"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding SelectedPluginDescription}" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SelectedPluginRuntimeKindLabel}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="{Binding SaveSettingsText}"
                                                Command="{Binding SaveSettingsCommand}" />
                                        <Button Content="{Binding ResetProfileText}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ResetPluginSettingsCommand}" />
                                        <Button Content="{Binding ChooseIconText}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ChoosePluginIconCommand}" />
                                        <Button Content="{Binding ClearIconText}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding ClearPluginIconCommand}" />
                                        <Button Content="{Binding OpenPluginFolderText}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding OpenPluginFolderCommand}" />
                                        <Button Content="{Binding DeletePluginText}"
                                                Command="{Binding DeletePluginCommand}"
                                                Style="{StaticResource DangerButtonStyle}" />
                                    </WrapPanel>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Padding="12"
                                        Background="{StaticResource SurfaceInsetBrush}"
                                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding StatusText}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12.5"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding AutosaveStatus}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.95*" />
                                <ColumnDefinition Width="1.35*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Margin="0,0,14,0"
                                    Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                               Text="{Binding GeneralControlsText}" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Text="{Binding MasterOpacityText}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentMutedBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding MasterOpacity, StringFormat={}{0:P0}}" />
                                    </Grid>
                                    <Slider Minimum="0.1"
                                            Maximum="1.0"
                                            Value="{Binding MasterOpacity}"
                                            TickFrequency="0.02" />

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Text="{Binding FpsCapText}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentMutedBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding TargetFps, StringFormat={}{0:F0}}" />
                                    </Grid>
                                    <Slider Minimum="30"
                                            Maximum="144"
                                            Value="{Binding TargetFps}"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True" />

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Text="{Binding CursorAttachText}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentMutedBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding CursorAttachStrength, StringFormat={}{0:0.0}x}" />
                                    </Grid>
                                    <Slider Minimum="1.0"
                                            Maximum="4.0"
                                            Value="{Binding CursorAttachStrength}"
                                            TickFrequency="0.1" />

                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Text="{Binding CursorAttachHintText}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                               Text="{Binding PluginAuthoringText}" />
                                    <TextBlock Margin="0,10,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Text="{Binding PluginAuthoringHintText}" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="{Binding OpenAuthoringGuideText}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding OpenPluginAuthoringGuideCommand}" />
                                        <Button Content="{Binding ImportPluginText}"
                                                Command="{Binding ImportTemplateCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                           Text="{Binding ProfileControlsText}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12.5"
                                           Text="{Binding ProfileControlsHintText}" />

                                <Border Margin="0,14,0,0"
                                        Padding="10"
                                        Background="{StaticResource SurfaceInsetBrush}"
                                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding BasicText}" />
                                        <TextBlock Margin="0,4,0,12"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11.5"
                                                   Text="{Binding BasicHintText}" />
                                        <ItemsControl ItemsSource="{Binding BasicPluginCategories}" />
                                    </StackPanel>
                                </Border>

                                <Expander Margin="0,12,0,0"
                                          IsExpanded="False"
                                          Header="{Binding AdvancedText}">
                                    <Expander.Style>
                                        <Style TargetType="Expander" BasedOn="{StaticResource CompactExpanderStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAdvancedParameters}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Expander.Style>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Margin="0,0,0,12"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11.5"
                                                   Text="{Binding AdvancedHintText}" />
                                        <ItemsControl ItemsSource="{Binding AdvancedPluginCategories}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource PanelCardStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExternalPluginSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                           Text="{Binding PluginDiagnosticsText}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding DiagnosticsStatusText}" />
                                    <TextBlock Grid.Column="1"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentMutedBrush}"
                                               Text="{Binding SelectedPluginDiagnosticsStatus}" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding DiagnosticsAssemblyText}" />
                                    <TextBlock Grid.Column="1"
                                               TextWrapping="Wrap"
                                               Text="{Binding SelectedPluginDiagnosticsAssembly}" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding DiagnosticsAssemblyPathText}" />
                                    <TextBlock Grid.Column="1"
                                               TextWrapping="Wrap"
                                               Text="{Binding SelectedPluginDiagnosticsAssemblyPath}" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding DiagnosticsEntryTypeText}" />
                                    <TextBlock Grid.Column="1"
                                               TextWrapping="Wrap"
                                               Text="{Binding SelectedPluginDiagnosticsEntryType}" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding DiagnosticsLoadedAtText}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedPluginDiagnosticsLoadedAt}" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource SubtleTextBrush}" Text="{Binding DiagnosticsLastErrorText}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedPluginDiagnosticsLastErrorAt}" />
                                </Grid>
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedPluginDiagnosticsContext}" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedPluginDiagnosticsMessage}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Padding="18"
                Background="{StaticResource CardBackgroundSecondaryBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                PreviewMouseWheel="OnProfilesPaneMouseWheel">
            <ScrollViewer x:Name="ProfilesScrollViewer"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="21"
                               FontWeight="SemiBold"
                               Text="{Binding ProfilesText}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13"
                               Text="{Binding ProfilesHintText}" />

                    <Border Margin="0,14,0,0"
                            Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                       Text="{Binding BuiltInProfilesText}" />
                            <TextBlock Margin="0,6,0,10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Text="{Binding BuiltInProfilesSummary}" />
                            <ListBox ItemsSource="{Binding BuiltInPlugins}"
                                     SelectedItem="{Binding SelectedPlugin}"
                                     PreviewMouseWheel="OnProfilesPaneMouseWheel"
                                     ItemTemplate="{StaticResource PluginListItemTemplate}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                           Text="{Binding ImportedPluginsText}" />
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding ImportShortText}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ImportTemplateCommand}" />
                            </DockPanel>
                            <TextBlock Margin="0,6,0,10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Text="{Binding ImportedProfilesSummary}" />
                            <ListBox ItemsSource="{Binding ImportedPlugins}"
                                     SelectedItem="{Binding SelectedPlugin}"
                                     PreviewMouseWheel="OnProfilesPaneMouseWheel"
                                     ItemTemplate="{StaticResource PluginListItemTemplate}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>


