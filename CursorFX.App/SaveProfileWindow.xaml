<Window x:Class="CursorFX.App.SaveProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, RelativeSource={RelativeSource AncestorType=Window}}"
        Icon="pack://application:,,,/Assets/FluxorIco.ico"
        Width="520"
        Height="330"
        MinWidth="480"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Padding="0,12,0,0"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding CancelText, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnCancelClick" />
                <Button Content="{Binding ConfirmText, RelativeSource={RelativeSource AncestorType=Window}}"
                        Click="OnConfirmClick" />
            </StackPanel>
        </Border>

        <StackPanel>
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Text="{Binding HeadingText, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Margin="0,10,0,18"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding IntroText, RelativeSource={RelativeSource AncestorType=Window}}" />

            <Border Padding="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding NameLabelText, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBox Margin="0,8,0,0"
                             Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,16,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding DescriptionLabelText, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBox Margin="0,8,0,0"
                             Height="78"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding ProfileDescription, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
